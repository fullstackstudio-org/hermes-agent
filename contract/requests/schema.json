        "dir": {
          "minLength": 2,
          "pattern": "^/",
          "title": "Dir",
          "type": "string"
        },
        "max_bytes": {
          "maximum": 104857600,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
