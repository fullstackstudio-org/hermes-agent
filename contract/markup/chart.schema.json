{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermie.app/contract/markup/chart.schema.json",
  "title": "hermie-chart block",
  "description": "The JSON object inside a fenced code block whose language is hermie-chart (docs/charts.md in the Hermie apps repository). A block that does not validate is shown as code, never repaired. Rules JSON Schema cannot state are in README.md (every values list is as long as x; series names unique; a pie's values not negative with one above zero).",
  "x-maxSourceBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "x", "series"],
  "properties": {
    "type": {"enum": ["bar", "line", "pie"]},
    "title": {"type": ["string", "null"], "maxLength": 120},
    "unit": {"type": ["string", "null"], "maxLength": 12},
    "x": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1, "maxLength": 60},
          {"type": "number"}
        ]
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/series"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "pie"}}},
      "then": {
        "properties": {
          "x": {"maxItems": 24},
          "series": {"maxItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "values": {
          "type": "array",
          "items": {"type": "number", "minimum": -1e15, "maximum": 1e15}
        }
      }
    }
  }
}
