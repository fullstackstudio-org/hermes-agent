            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "default": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
              "type": "string"
