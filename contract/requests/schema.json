          "const": "amount",
          "title": "Kind",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$",
              "type": "string"
