{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by scripts/gen_gateway_contracts.py from tui_gateway/contracts/server_requests.py - DO NOT EDIT. See README.md; examples.json is normative.",
  "title": "Hermie interactive server requests",
  "version": 1,
  "envelope": {
    "$ref": "#/$defs/InteractiveRequestParams"
  },
  "methods": {
    "input.form": {
      "summary": "The agent asks the person to fill in a form of typed fields (1-12). 300 s.",
      "params": {
        "$ref": "#/$defs/InputFormRequestParams"
      },
      "result": {
        "$ref": "#/$defs/InputFormResult"
      }
    },
    "input.file": {
      "summary": "The agent asks the person for one or more files (photo, scan, document, audio), uploaded to upload.dir and answered by reference. 300 s.",
      "params": {
        "$ref": "#/$defs/InputFileRequestParams"
      },
      "result": {
        "$ref": "#/$defs/InputFileResult"
      }
    },
    "review.draft": {
      "summary": "The agent shows the person a draft (mail, post, message, document) to approve, edit or reject before it acts on it. 300 s.",
      "params": {
        "$ref": "#/$defs/ReviewDraftRequestParams"
      },
      "result": {
        "$ref": "#/$defs/ReviewDraftResult"
      }
    }
  },
  "errors": {
    "cannot_show": 4041,
    "answer_refused": 4034
  },
