    "InteractiveRequestParams": {
      "additionalProperties": false,
      "description": "The envelope of every interactive request. ``v`` is ``1``: a client that does not know the version\nanswers ``4041`` with reason ``unsupported_version``. ``title`` is one line; ``summary`` is the agent's\nwords; ``detail`` is shown monospaced. ``expires_at`` (Unix seconds, set by the gateway) is when the\ngateway stops waiting: a client hides the request then, and an answer after it is refused. ``optional``\nsays whether Skip is offered (``input.*``: true by default; ``review.*``: false). ``acting_user`` is\nset when the gateway can name the person the turn acts for.\n\nSent only to connections that listed the method under ``client.capabilities`` ``requests``. A client\nthat cannot show the request answers a JSON-RPC ERROR ``4041`` (``cannot_show``) with ``data.reason``,\nnever a made-up ``skipped`` or ``rejected``; the gateway reports that as ``unavailable``. A refused\nanswer is ``request.answer`` error ``4034`` with ``data.reason`` (``bad_shape``, ``not_optional``,\n``field:<id>:<problem>``, …, ``contract/requests/README.md``) and leaves the request open.",
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "expires_at": {
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "optional": {
          "title": "Optional",
          "type": "boolean"
        },
        "acting_user": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestActingUser"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "session_id",
        "v",
        "title",
        "summary",
        "expires_at",
        "optional"
      ],
      "title": "InteractiveRequestParams",
      "type": "object"
    },
